// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Local dev uses SQLite (file:./dev.db) via the libsql driver adapter — no
// native build tools required on this machine. Swap `provider` to
// "postgresql" and DATABASE_URL to a Neon/Postgres connection string before
// deploying to production; enums are deliberately avoided below (String
// fields + TS union types instead) so that swap needs no field changes.

generator client {
  provider = "prisma-client"
  output   = "../src/backend/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToCategory")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  brand       String
  price       Int
  mrp         Int?
  stock       Int      @default(0)
  specs       String   @default("{}")
  isActive    Boolean  @default(true)

  categoryId String
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)

  @@index([productId])
}

// status: "NEW" | "CONTACTED" | "COMPLETED" | "CANCELLED" (see src/backend/lib/order-status.ts)
// checkoutMethod: "WHATSAPP" | "ONLINE_PAYMENT"
model Order {
  id             String  @id @default(cuid())
  customerName   String
  phone          String
  address        String
  total          Int
  status         String  @default("NEW")
  checkoutMethod String
  /// Slug of the branch the customer chose (src/shared/branches.ts).
  branch         String?
  /// The customer's note from the order form.
  note           String?
  /// Internal note for the team; never shown to the customer.
  staffNote      String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Int
  quantity  Int

  @@index([orderId])
}

// Bank, card, EMI and UPI offers shown as "Super Savings" on product pages.
// kind: "BANK" | "CREDIT_CARD" | "DEBIT_CARD" | "EMI" | "UPI" (see src/shared/offers.ts)
model Offer {
  id        String    @id @default(cuid())
  kind      String
  /// Who gives it: "HDFC Bank", "Bajaj Finserv", "Tata Neu UPI".
  provider  String
  logoUrl   String?
  /// The headline on the card: "Up to ₹4,000 instant discount".
  title     String
  /// Full terms, shown when the shopper taps View more.
  details   String
  /// Comma-separated brand slugs (PHONE_BRANDS); empty means every brand.
  brands    String    @default("")
  /// Shown only on phones priced at least this much (rupees).
  minPrice  Int?
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  /// Lower shows first.
  position  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  createdAt DateTime @default(now())
}
