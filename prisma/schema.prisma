// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Local dev uses SQLite (file:./dev.db) via the libsql driver adapter — no
// native build tools required on this machine. Swap `provider` to
// "postgresql" and DATABASE_URL to a Neon/Postgres connection string before
// deploying to production; enums are deliberately avoided below (String
// fields + TS union types instead) so that swap needs no field changes.

generator client {
  provider = "prisma-client"
  output   = "../src/backend/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToCategory")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  brand       String
  price       Int
  mrp         Int?
  stock       Int      @default(0)
  specs       String   @default("{}")
  isActive    Boolean  @default(true)

  categoryId String
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)

  @@index([productId])
}

// status: "PENDING" | "AWAITING_PAYMENT" | "PAID" | "CONFIRMED_WHATSAPP" | "FULFILLED" | "CANCELLED"
// checkoutMethod: "WHATSAPP" | "ONLINE_PAYMENT"
model Order {
  id             String @id @default(cuid())
  customerName   String
  phone          String
  address        String
  total          Int
  status         String @default("PENDING")
  checkoutMethod String

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Int
  quantity  Int

  @@index([orderId])
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  createdAt DateTime @default(now())
}
